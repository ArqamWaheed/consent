# Optional. Without these the app runs in snapshot mode and says so on screen.
#
# The app connects as CONSENT_APP, which has SELECT on exactly three objects and
# no access at all to RAW_CASES. Do not point it at an admin role "to make the
# demo easier" — the restricted role IS the demo.

SNOWFLAKE_ACCOUNT=orgname-accountname
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=CONSENT_APP
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=CONSENT
SNOWFLAKE_SCHEMA=APP

# Pick one. Key-pair is preferred; Snowflake is retiring password auth for
# service users. See docs.snowflake.com/en/user-guide/key-pair-auth
SNOWFLAKE_PRIVATE_KEY_FILE=
SNOWFLAKE_PASSWORD=
